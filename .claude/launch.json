{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "frontend-angular",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend-angular", "start"],
      "port": 3001
    },
    {
      "name": "frontend-angular-prod",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4301", "-d", "frontend-angular/dist/remembermap-frontend-angular/browser"],
      "port": 4301
    }
  ]
}
