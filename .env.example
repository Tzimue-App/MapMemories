# Copy to .env (git-ignored) and replace every value before exposing the stack.
# docker compose reads it automatically.

APP_VERSION=local

POSTGRES_DB=remembermap
POSTGRES_USER=remembermap
POSTGRES_PASSWORD=change-me

MINIO_ACCESS_KEY=remembermap_access
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_BUCKET=remembermap-photos

# Base64-encoded HMAC key of at least 256 bits, e.g. `openssl rand -base64 48`
APP_JWT_SECRET=change-me

FRONTEND_PORT=3000
FRONTEND_ANGULAR_PORT=3001
